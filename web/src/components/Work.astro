---
// Selected work: a 3×3 grid (React island, components/ProjectFrames.tsx on top of
// components/ui/dynamic-frame-layout.tsx). Mystré sits in the centre; the eight frames around it are project
// categories. Hovering a category widens its row and column and shows its projects, with arrows inside the
// frame to step through them. Loads when the section comes into view.
import '../styles/tailwind.css';
import Icon from './Icon.astro';
import ProjectFrames from './ProjectFrames';
import type { FrameProject, FrameCategory } from './ProjectFrames';
import { projects, categories } from '../data/profile';
import type { Project } from '../data/profile';

const toFrame = (p: Project): FrameProject => ({
  slug: p.slug,
  title: p.title,
  line: p.line ?? p.summary,
  image: p.image,
  live: p.links.find((l) => l.href.startsWith('http') && !l.href.includes('github.com'))?.href,
  repo: p.links.find((l) => l.href.includes('github.com'))?.href,
});
const featured = toFrame(projects.find((p) => p.slug === 'mystre') ?? projects[0]);
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const cats: FrameCategory[] = categories.map((c) => ({
  id: c.id, name: c.name,
  projects: c.projects.map((slug) => bySlug.get(slug)).filter((p): p is Project => !!p).map(toFrame),
}));
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work-head">
      <div class="section-head">
        <p class="eyebrow"><span class="num">02</span> Selected work</p>
        <h2 id="work-title" class="section-title" data-split>What I’ve built.</h2>
      </div>
      <a class="link-arrow" href="/projects"><span>More projects</span><Icon name="arrow-up-right" /></a>
    </div>
    <ProjectFrames client:visible featured={featured} featuredNote="the startup I founded" categories={cats} />
  </div>
</section>

<style>
  .work-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .work-head .section-head, .work-head > .link-arrow { margin-bottom: clamp(28px, 4vw, 48px); }

  /* The React island's markup (not scoped by Astro, hence :global). */
  :global(.pf-grid-wrap) { height: min(84vh, 820px); min-height: 560px; }
  :global(.pf-cell) { border-radius: 10px; overflow: hidden; background: #111; border: 1px solid var(--line); }
  :global(.pf-img) { filter: brightness(0.7) saturate(0.9); transition: scale 1.2s var(--ease-out), filter 0.5s ease; }
  :global(.pf-idle .pf-img) { filter: blur(10px) brightness(0.42) saturate(0.8); scale: 1.12; }
  :global(.pf-cell[data-hovered] .pf-img) { scale: 1.04; }
  :global(.pf-featured) { cursor: pointer; }
  :global(.pf-featured .pf-img) { filter: none; }
  :global(.pf-featured:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  :global(.pf-featured) { container-type: inline-size; }
  :global(.pf-feat-bar) {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 12px;
    padding: 12px clamp(14px, 1.3vw, 18px); color: #f0ede8; background: rgba(10, 10, 10, 0.84);
    backdrop-filter: blur(16px) saturate(1.1); -webkit-backdrop-filter: blur(16px) saturate(1.1); border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  :global(.pf-feat-tag) {
    flex: none; padding: 4px 9px; border-radius: 999px; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase; color: #0e0e0e; background: var(--accent);
  }
  :global(.pf-feat-text) { flex: 1; min-width: 0; font-size: 14px; line-height: 1.3; color: rgba(240, 237, 232, 0.88); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.pf-feat-text b) { font-family: var(--font-display); font-weight: 700; color: #f0ede8; }
  :global(.pf-feat-go) { flex: none; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12px; color: rgba(240, 237, 232, 0.8); transition: color 0.2s ease; }
  :global(.pf-featured:hover .pf-feat-go) { color: var(--accent); }
  @container (max-width: 440px) { :global(.pf-feat-host) { display: none; } }
  @container (max-width: 300px) { :global(.pf-feat-tag) { display: none; } }
  :global(.pf-empty) {
    background: radial-gradient(120% 90% at 20% 10%, rgba(201, 169, 110, 0.28), transparent 60%),
      radial-gradient(100% 80% at 90% 100%, rgba(47, 77, 74, 0.45), transparent 60%), #161513;
  }
  :global(.pf-empty-mark) {
    position: absolute; left: clamp(14px, 1.4vw, 22px); right: clamp(14px, 1.4vw, 22px); top: 22%;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 4vw, 64px); line-height: 0.95;
    letter-spacing: -0.03em; color: rgba(240, 237, 232, 0.16); overflow: hidden; text-overflow: ellipsis;
  }
  :global(.pf-shade) { background: linear-gradient(to top, rgba(8, 8, 8, 0.55) 0%, rgba(8, 8, 8, 0) 45%); }
  :global(.pf-body) {
    z-index: 2; display: grid; gap: 8px; padding: clamp(14px, 1.3vw, 20px); color: #f0ede8; pointer-events: none;
    background: rgba(10, 10, 10, 0.84); backdrop-filter: blur(16px) saturate(1.1); -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  :global(.pf-title) { font-family: var(--font-display); font-weight: 700; font-size: clamp(17px, 1.5vw, 24px); line-height: 1.1; letter-spacing: -0.02em; color: #f0ede8; }
  :global(.pf-line) { font-size: 14px; line-height: 1.5; color: rgba(240, 237, 232, 0.88); max-width: 44ch; }
  :global(.pf-links) { display: flex; gap: 14px; pointer-events: auto; }
  :global(.pf-links a) { display: inline-grid; place-items: center; width: 28px; height: 28px; color: #f0ede8; transition: color 0.2s ease, translate 0.3s var(--ease-out); }
  :global(.pf-links a:hover) { color: var(--accent); translate: 0 -2px; }
  :global(.pf-cell[data-hovered]) { border-color: rgba(201, 169, 110, 0.45); }

  /* Category frames: at rest the name and count; hovered or focused, the projects with arrows inside. */
  :global(.pf-idle), :global(.pf-view) { transition: opacity 0.4s ease, visibility 0s linear 0.4s; }
  :global(.pf-view) { opacity: 0; visibility: hidden; }
  :global(.pf-cell[data-hovered] .pf-idle) { opacity: 0; visibility: hidden; }
  :global(.pf-cell[data-hovered] .pf-view) { opacity: 1; visibility: visible; transition: opacity 0.45s ease, visibility 0s; }
  :global(.pf-idle-shade) { background: linear-gradient(to top, rgba(8, 8, 8, 0.82) 0%, rgba(8, 8, 8, 0.45) 60%, rgba(8, 8, 8, 0.35) 100%); }
  :global(.pf-idle-text) { left: clamp(14px, 1.4vw, 22px); right: clamp(14px, 1.4vw, 22px); bottom: clamp(14px, 1.4vw, 22px); display: grid; gap: 6px; }
  :global(.pf-cat-count) { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  :global(.pf-cat-name) { font-family: var(--font-display); font-weight: 700; font-size: clamp(19px, 1.9vw, 30px); line-height: 1.05; letter-spacing: -0.02em; color: #f0ede8; }
  :global(.pf-cat-tag) {
    top: 12px; left: 12px; z-index: 3; padding: 5px 10px; border-radius: 999px; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.06em; text-transform: uppercase; color: #f0ede8; background: rgba(8, 8, 8, 0.55);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  /* Previous / next: small glass circles on the tile's edges; dots show where you are. */
  :global(.pf-arrow) {
    top: 40%; translate: 0 -50%; z-index: 4; width: 32px; height: 32px; display: grid; place-items: center; cursor: pointer;
    border-radius: 50%; border: 1px solid rgba(240, 237, 232, 0.35); color: #f0ede8; background: rgba(10, 10, 10, 0.5);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, scale 0.2s ease;
  }
  :global(.pf-arrow-prev) { left: 12px; }
  :global(.pf-arrow-next) { right: 12px; }
  :global(.pf-arrow:hover) { background: #f0ede8; border-color: #f0ede8; color: #0e0e0e; }
  :global(.pf-arrow:active) { scale: 0.92; }
  :global(.pf-arrow:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(.pf-dots) {
    top: 14px; right: 14px; z-index: 4; display: flex; align-items: center; gap: 5px; padding: 6px 8px; border-radius: 999px;
    background: rgba(10, 10, 10, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  :global(.pf-dots i) { width: 6px; height: 6px; border-radius: 999px; background: rgba(240, 237, 232, 0.4); transition: width 0.3s var(--ease-out), background 0.3s ease; }
  :global(.pf-dots i.on) { width: 16px; background: #f0ede8; }

  @media (max-width: 760px) {
    :global(.pf-grid-wrap) { height: auto; min-height: 0; }
    :global(.pf-grid) { grid-template-columns: 1fr !important; grid-template-rows: none !important; gap: 12px !important; }
    :global(.pf-cell) { grid-row: auto !important; grid-column: auto !important; aspect-ratio: 16 / 10; }
    :global(.pf-cell:last-child) { order: -1; }
    :global(.pf-idle) { opacity: 0; visibility: hidden; }
    :global(.pf-view) { opacity: 1; visibility: visible; }
  }
</style>
