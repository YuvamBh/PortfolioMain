---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { CHAT_ENABLED } from '../data/flags';
const lines = profile.highlights.map((h) => h.text);
const tags = profile.highlights.map((h) => h.tag);
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-orb" data-orb aria-hidden="true"></div>
  <div class="wrap hero-inner" data-hero-inner>
    <p class="hero-role" data-hero-fade>
      <span class="code-slash" aria-hidden="true">//</span>
      <span class="roll" aria-hidden="true" data-roll>{profile.roleWords.map((w) => <span class="roll-word">{w}</span>)}</span>
      <span class="sr-only">{profile.role}</span>
    </p>
    <h1 id="hero-title" class="hero-title" data-hero-title>Hey, I’m Yuvam.</h1>
    <div class="hero-row">
      <div class="cycle" data-hero-fade data-cycle-box>
        <span class="cycle-tag" data-cycle-tag data-tags={JSON.stringify(tags)} aria-hidden="true">{tags[0]}</span>
        <p class="cycle-text" data-cycle data-lines={JSON.stringify(lines)} aria-hidden="true">{lines[0]}</p>
        <ul class="sr-only">{profile.highlights.map((h) => <li>{h.tag}: {h.text}</li>)}</ul>
        <div class="cycle-ctrl" data-cycle-ctrl>
          <span class="cycle-dashes" role="group" aria-label="Highlights">
            {lines.map((_, i) => (
              <button type="button" class:list={['cycle-dash', { on: i === 0 }]} data-dash={i} aria-label={`Highlight ${i + 1} of ${lines.length}`} aria-current={i === 0 ? 'true' : undefined}>
                <span class="dash-track"><span class="dash-fill"></span></span>
              </button>
            ))}
          </span>
          <button type="button" class="cycle-pause" data-cycle-pause aria-pressed="false" aria-label="Pause the rotating highlights">
            <svg class="i-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor" /></svg>
            <svg class="i-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2l7 4-7 4z" fill="currentColor" /></svg>
          </button>
        </div>
      </div>
      <div class="hero-side">
        <p class="prose hero-lede" data-hero-fade>
          Founder of <a href="https://www.mystre.app" target="_blank" rel="noopener">Mystré</a> and President of the Claude Builders Club.
          I build AI products and full-stack platforms, from the first sketch to a live product.
        </p>
        <div class="hero-cta" data-hero-fade>
          <a class="btn btn-primary" href="https://www.mystre.app" target="_blank" rel="noopener">Visit Mystré <Icon name="arrow-up-right" /></a>
          {CHAT_ENABLED && <button class="btn" type="button" data-chat-open><Icon name="sparkle" /> Ask my AI</button>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--nav-h) + 48px) 0 28px; overflow: hidden; isolation: isolate;
  }
  .hero-orb {
    position: absolute; z-index: -1; width: min(1000px, 130vw); aspect-ratio: 1; left: calc(50% - min(500px, 65vw)); top: -48%;
    border-radius: 50%; filter: blur(100px); opacity: 0.32;
    background: radial-gradient(circle at 40% 40%, rgba(var(--accent-rgb), 0.7), transparent 62%);
  }
  :global([data-theme='dark']) .hero-orb { display: none; } /* no glow behind the hero in dark */
  .hero-inner { display: grid; gap: clamp(16px, 2vw, 24px); }
  .hero-role {
    display: flex; align-items: center; gap: 0.6em; min-height: 1.6em;
    font-family: var(--font-mono); font-weight: 400; font-size: clamp(14px, 1.1vw, 16px); letter-spacing: 0.02em;
    color: var(--text-2); text-transform: lowercase;
  }
  .code-slash { color: var(--accent); }
  /* Role words, stacked in one cell (as wide as the longest, so nothing shifts); one shows at a time and the
     next rolls up into its place. */
  .roll { display: inline-grid; overflow: hidden; padding-block: 0.12em; }
  .roll-word { grid-area: 1 / 1; white-space: nowrap; }
  .roll-word:not(:first-child) { opacity: 0; }
  .hero-title { font-weight: 700; font-size: clamp(52px, 8.6vw, 150px); line-height: 0.92; letter-spacing: -0.04em; }
  .hero-row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px clamp(32px, 5vw, 80px);
    align-items: end; margin-top: clamp(20px, 3vw, 44px);
  }
  .cycle { display: grid; gap: 18px; align-content: end; }
  /* Small square tag above each highlight: Shipped or Built. */
  .cycle-tag {
    justify-self: start; padding: 5px 8px; border-radius: 2px;
    font-family: var(--font-mono); font-size: 10px; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-2); background: rgba(var(--ink), 0.08);
  }
  .cycle-text {
    font-family: var(--font-body); font-weight: 400; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.32; letter-spacing: -0.02em;
    color: var(--text); min-height: 3.96em; max-width: 30ch;
  }
  /* Laid out from the first paint (so nothing shifts when the script starts), shown once it runs. */
  .cycle-ctrl { display: flex; align-items: center; gap: 14px; opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0s linear 0.5s; }
  .cycle-ctrl.is-on { opacity: 1; visibility: visible; transition: opacity 0.5s ease, visibility 0s; }
  /* One bar per highlight: click one to jump to it; the current one fills up until the next line loads. */
  .cycle-dashes { display: flex; gap: 4px; }
  .cycle-dash { width: 30px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer; display: grid; align-items: center; }
  .dash-track { display: block; height: 2px; overflow: hidden; background: rgba(var(--ink), 0.22); transition: background 0.3s ease, height 0.3s var(--ease-out); }
  .cycle-dash:hover .dash-track { background: rgba(var(--ink), 0.45); height: 3px; }
  .cycle-dash.on .dash-track { height: 3px; }
  .dash-fill { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left center; }
  .cycle-dash:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cycle-pause {
    width: 32px; height: 32px; display: grid; place-items: center; cursor: pointer; color: var(--text-2);
    background: rgba(var(--ink), 0.04); border: 1px solid rgba(var(--ink), 0.2); transition: color 0.2s, border-color 0.2s;
  }
  .cycle-pause:hover { color: var(--text); border-color: rgba(var(--ink), 0.45); }
  .cycle-pause .i-play, .cycle-pause[aria-pressed='true'] .i-pause { display: none; }
  .cycle-pause[aria-pressed='true'] .i-play { display: block; }
  .hero-side { display: grid; gap: 24px; }
  .hero-lede { max-width: 46ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-foot {
    margin-top: clamp(40px, 7vh, 88px); display: flex; justify-content: space-between; align-items: center;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-3);
  }
  @media (max-width: 960px) {
    .hero-row { grid-template-columns: 1fr; }
  }
</style>
