---
// The nav, in the spirit of destroai.com: a compact glass panel in the top-left corner with the name, a
// breadcrumb that follows the section on screen, and a Menu button that opens a glass dropdown. The theme
// toggle sits on its own in the top-right corner.
import { profile } from '../data/profile';
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
const page = Astro.url.pathname.startsWith('/projects') ? 'Projects' : Astro.url.pathname.startsWith('/404') ? 'Not found' : 'Home';
const links = [
  { label: 'About', href: `${base}#about` },
  { label: 'Work', href: `${base}#work` },
  { label: 'Toolkit', href: `${base}#toolkit` },
  { label: 'Experience', href: `${base}#experience` },
  { label: 'Leadership', href: `${base}#leadership` },
  { label: 'Accomplishments', href: `${base}#accomplishments` },
  { label: 'All projects', href: '/projects' },
  { label: 'Contact', href: `${base}#contact` },
];
---
<div class="nav-wrap" data-nav>
  <nav class="panel" aria-label="Primary">
    <a class="brand" href="/" aria-label="Yuvam Bhargav, home">yuvam bhargav<span aria-hidden="true">.</span></a>
    <span class="divider" aria-hidden="true"></span>
    <span class="crumb" aria-hidden="true">/ <span data-crumb>{page}</span></span>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu" data-menu-open>
      <span class="dots" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16">
          {[2, 8, 14].map((y) => [2, 8, 14].map((x) => <circle cx={x} cy={y} r="1.5" fill="currentColor" />))}
        </svg>
      </span>
    </button>
  </nav>

  <div class="dropdown" id="nav-menu" hidden data-menu>
    <ol class="dd-links">
      {links.map((l, i) => (
        <li><a href={l.href} data-menu-link><span class="dd-num">{String(i + 1).padStart(2, '0')}</span>{l.label}</a></li>
      ))}
    </ol>
    <div class="dd-foot">
      <div class="seg seg-phone" role="group" aria-label="Theme">
        <button type="button" data-theme-set="light">Light</button>
        <button type="button" data-theme-set="dark">Dark</button>
      </div>
      <a class="dd-resume" href={profile.resume} target="_blank" rel="noopener">Resume ↗</a>
    </div>
  </div>
</div>

<div class="corner-right">
  <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch to the light theme" title="Light">
    <svg class="theme-icon" width="16" height="16" viewBox="0 0 14 14" aria-hidden="true">
      <circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.1" />
      <path d="M7 0.75 A6.25 6.25 0 0 1 7 13.25 Z" fill="currentColor" />
    </svg>
  </button>
</div>

<style>
  .nav-wrap { position: fixed; z-index: 90; top: 16px; left: 16px; }
  .panel, .dropdown, .theme-btn {
    background: rgba(var(--glass-top), 0.42);
    backdrop-filter: blur(24px) saturate(1.8); -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  :global([data-theme='light']) .panel, :global([data-theme='light']) .dropdown, :global([data-theme='light']) .theme-btn {
    background: rgba(245, 245, 243, 0.62); border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 10px 30px -18px rgba(60, 45, 30, 0.35);
  }
  .panel { display: flex; align-items: center; gap: 14px; height: 64px; padding: 0 12px 0 20px; border-radius: 2px; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 18px; letter-spacing: -0.03em; line-height: 1; text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--accent); }
  .divider { width: 1px; height: 18px; background: rgba(var(--ink), 0.18); }
  .crumb { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); white-space: nowrap; min-width: 112px; }
  .crumb span { display: inline-block; transition: opacity 0.25s ease, transform 0.35s var(--ease-out); }
  .crumb span.swap { opacity: 0; transform: translateY(6px); }
  .menu-toggle { display: inline-flex; align-items: center; height: 44px; padding: 0; margin-left: 4px; border: 0; background: none; cursor: pointer; color: var(--text); }
  .dots {
    width: 40px; height: 40px; display: grid; place-items: center; border-radius: 4px;
    background: rgba(var(--ink), 0.08); border: 1px solid rgba(var(--ink), 0.1);
    transition: background 0.25s ease, transform 0.5s var(--ease-out);
  }
  .menu-toggle:hover .dots { background: rgba(var(--ink), 0.14); }
  .menu-toggle[aria-expanded='true'] .dots { transform: rotate(45deg); }

  .dropdown { margin-top: 8px; width: 100%; min-width: 300px; padding: 10px 10px 12px; border-radius: 2px; transform-origin: top left; }
  .dropdown[hidden] { display: none; }
  .dropdown.open { animation: dd-in 0.45s var(--ease-out); }
  .dropdown.closing { animation: dd-out 0.32s cubic-bezier(0.55, 0, 0.75, 0.2) forwards; pointer-events: none; }
  @keyframes dd-in { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes dd-out { from { opacity: 1; clip-path: inset(0 0 0 0); } to { opacity: 0; clip-path: inset(0 0 100% 0); } }
  .dd-links { list-style: none; margin: 0; padding: 0; }
  .dd-links a {
    display: flex; align-items: baseline; gap: 14px; min-height: 44px; padding: 8px 10px; border-radius: 2px;
    font-size: 17px; font-weight: 500; text-decoration: none; color: var(--text); transition: background 0.2s ease;
  }
  .dd-links a:hover, .dd-links a:focus-visible { background: rgba(var(--ink), 0.07); }
  .dropdown.open .dd-links li { animation: dd-item 0.5s var(--ease-out) both; }
  .dropdown.open .dd-links li:nth-child(2) { animation-delay: 0.03s; }
  .dropdown.open .dd-links li:nth-child(3) { animation-delay: 0.06s; }
  .dropdown.open .dd-links li:nth-child(4) { animation-delay: 0.09s; }
  .dropdown.open .dd-links li:nth-child(5) { animation-delay: 0.12s; }
  .dropdown.open .dd-links li:nth-child(6) { animation-delay: 0.15s; }
  .dropdown.open .dd-links li:nth-child(7) { animation-delay: 0.18s; }
  @keyframes dd-item { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .dropdown.closing .dd-links li { animation: dd-item-out 0.24s ease-in both; }
  .dropdown.closing .dd-links li:nth-last-child(2) { animation-delay: 0.02s; }
  .dropdown.closing .dd-links li:nth-last-child(3) { animation-delay: 0.04s; }
  .dropdown.closing .dd-links li:nth-last-child(4) { animation-delay: 0.06s; }
  @keyframes dd-item-out { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-6px); } }
  .dd-num { font-family: var(--font-mono); font-size: 11px; color: var(--accent); }
  .dd-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; padding: 12px 10px 0; border-top: 1px solid rgba(var(--ink), 0.12); }
  .seg { display: inline-flex; border: 1px solid rgba(var(--ink), 0.16); border-radius: 2px; }
  .seg button {
    min-height: 36px; padding: 0 14px; border: 0; background: transparent; cursor: pointer; color: var(--text-2);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .seg button[aria-pressed='true'] { background: var(--text); color: var(--bg); }
  .dd-resume { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); text-decoration: none; min-height: 36px; display: inline-flex; align-items: center; }
  .dd-resume:hover { color: var(--text); }

  .corner-right { position: fixed; z-index: 90; top: 24px; right: 16px; display: flex; align-items: center; gap: 8px; }
  /* Theme toggle (after Mystré's): a glass square as tall as the menu button's row; the half-filled circle
     turns over when the theme changes. */
  .theme-btn {
    width: 48px; height: 48px; border-radius: 2px; cursor: pointer; color: var(--text);
    display: grid; place-items: center; transition: border-color 0.25s ease;
  }
  .theme-btn:hover { border-color: rgba(var(--ink), 0.45); }
  .theme-icon { transition: transform 0.6s var(--ease-out); }
  :global([data-theme='light']) .theme-icon { transform: rotate(180deg); }

  .seg-phone { display: none; }
  @media (max-width: 760px) {
    .corner-right { display: none; }
    .seg-phone { display: inline-flex; }
    .nav-wrap { left: 10px; right: 10px; top: 10px; }
    .panel { height: 58px; padding: 0 8px 0 16px; justify-content: space-between; }
    .crumb { min-width: 0; }
  }
  @media (max-width: 380px) {
    .divider, .crumb { display: none; }
  }
</style>

<script>
  const html = document.documentElement;

  // Theme: Light / Dark in the dropdown.
  const seg = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-set]'));
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncTheme = () => {
    seg.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === html.dataset.theme)));
    const dark = html.dataset.theme === 'dark';
    themeBtn?.setAttribute('aria-label', dark ? 'Switch to the light theme' : 'Switch to the dark theme');
    themeBtn?.setAttribute('title', dark ? 'Light' : 'Dark');
  };
  const setTheme = (t: string) => { html.dataset.theme = t; localStorage.setItem('theme', t); syncTheme(); };
  syncTheme();
  seg.forEach((b) => b.addEventListener('click', () => setTheme(b.dataset.themeSet ?? 'dark')));
  themeBtn?.addEventListener('click', () => setTheme(html.dataset.theme === 'dark' ? 'light' : 'dark'));

  // Breadcrumb follows the section on screen (home page only).
  const crumb = document.querySelector<HTMLElement>('[data-crumb]');
  const names: Record<string, string> = { about: 'About', work: 'Work', toolkit: 'Toolkit', experience: 'Experience', leadership: 'Leadership', accomplishments: 'Honors', contact: 'Contact' };
  const setCrumb = (text: string) => {
    if (!crumb || crumb.textContent === text) return;
    crumb.classList.add('swap');
    setTimeout(() => { crumb.textContent = text; crumb.classList.remove('swap'); }, 180);
  };
  if (location.pathname === '/' && 'IntersectionObserver' in window) {
    const hero = document.querySelector('[data-hero]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        setCrumb(e.target === hero ? 'Home' : names[e.target.id] ?? 'Home');
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    if (hero) io.observe(hero);
    Object.keys(names).forEach((id) => { const s = document.getElementById(id); if (s) io.observe(s); });
  }

  // Menu: opens the dropdown; Esc, a click outside, or choosing a link closes it.
  const wrap = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const isOpen = () => !!menu && !menu.hidden && !menu.classList.contains('closing');
  const open = () => {
    if (!menu || !toggle) return;
    menu.hidden = false; menu.classList.remove('open', 'closing'); void menu.offsetWidth; menu.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
  };
  // Closing plays the opening in reverse, then hides the dropdown.
  const close = (restore = true) => {
    if (!menu || !toggle || !isOpen()) return;
    toggle.setAttribute('aria-expanded', 'false');
    menu.classList.remove('open'); menu.classList.add('closing');
    const done = () => { menu.hidden = true; menu.classList.remove('closing'); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
    else menu.addEventListener('animationend', (e) => { if (e.target === menu) done(); }, { once: true });
    window.setTimeout(() => { if (menu.classList.contains('closing')) done(); }, 450);
    if (restore) toggle.focus({ preventScroll: true });
  };
  toggle?.addEventListener('click', () => (isOpen() ? close() : open()));
  document.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => close(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  document.addEventListener('pointerdown', (e) => { if (wrap && !wrap.contains(e.target as Node)) close(false); });
</script>
