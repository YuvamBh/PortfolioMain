---
// Drawn badges for the hackathon honors: a trophy in a laurel wreath (winner) and a judge's scorecard
// with a rosette (host and judge). Gold gradient; static (no hover animation).
interface Props { kind: 'trophy' | 'judge'; size?: number }
const { kind, size = 52 } = Astro.props;
---
<span class:list={['badge', `badge-${kind}`]} style={`--s:${size}px`} aria-hidden="true">
  {kind === 'trophy' ? (
    <svg viewBox="0 0 48 48" width={size} height={size}>
      <defs>
        <linearGradient id="b-gold-t" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f6dc9c" /><stop offset="0.55" stop-color="#d6ac5c" /><stop offset="1" stop-color="#a87a32" />
        </linearGradient>
        <linearGradient id="b-sheen" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.75" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <clipPath id="b-cup"><path d="M17 11h14v7.5a7 7 0 0 1-14 0z" /></clipPath>
      </defs>
      <g fill="none" stroke="url(#b-gold-t)" stroke-width="1.3" stroke-linecap="round">
        <path d="M12.5 36c-4.5-5-5.5-12.5-2-19" />
        <path d="M35.5 36c4.5-5 5.5-12.5 2-19" />
      </g>
      <g fill="url(#b-gold-t)">
        <ellipse cx="9.6" cy="20" rx="1.4" ry="3" transform="rotate(-25 9.6 20)" />
        <ellipse cx="8.9" cy="25.5" rx="1.4" ry="3" transform="rotate(-8 8.9 25.5)" />
        <ellipse cx="10" cy="31" rx="1.4" ry="3" transform="rotate(12 10 31)" />
        <ellipse cx="38.4" cy="20" rx="1.4" ry="3" transform="rotate(25 38.4 20)" />
        <ellipse cx="39.1" cy="25.5" rx="1.4" ry="3" transform="rotate(8 39.1 25.5)" />
        <ellipse cx="38" cy="31" rx="1.4" ry="3" transform="rotate(-12 38 31)" />
        <path d="M17 11h14v7.5a7 7 0 0 1-14 0z" />
        <rect x="22.6" y="25" width="2.8" height="4.6" />
        <rect x="18.5" y="29.4" width="11" height="2.6" rx="0.8" />
        <rect x="16.5" y="32" width="15" height="3.2" rx="1" opacity="0.85" />
      </g>
      <g fill="none" stroke="url(#b-gold-t)" stroke-width="1.6" stroke-linecap="round">
        <path d="M17 13.5h-3a3.2 3.2 0 0 0 4.2 5.4" />
        <path d="M31 13.5h3a3.2 3.2 0 0 1-4.2 5.4" />
      </g>
      <path d="M24 13.6l1.1 2.3 2.5.3-1.8 1.7.5 2.5-2.3-1.2-2.3 1.2.5-2.5-1.8-1.7 2.5-.3z" fill="#fff8e6" opacity="0.92" />
      <g clip-path="url(#b-cup)"><rect class="sheen" x="-14" y="8" width="10" height="20" fill="url(#b-sheen)" transform="skewX(-20)" /></g>
    </svg>
  ) : (
    <svg viewBox="0 0 48 48" width={size} height={size}>
      <defs>
        <linearGradient id="b-gold-j" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f6dc9c" /><stop offset="0.55" stop-color="#d6ac5c" /><stop offset="1" stop-color="#a87a32" />
        </linearGradient>
      </defs>
      <rect x="10.5" y="9" width="23" height="31" rx="3" fill="rgba(214,172,92,0.12)" stroke="url(#b-gold-j)" stroke-width="1.5" />
      <rect x="16.5" y="6.2" width="11" height="5.4" rx="1.6" fill="url(#b-gold-j)" />
      <g stroke="url(#b-gold-j)" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path class="tick t1" d="M14.6 18.4l1.7 1.7 3-3.4" stroke-width="1.6" />
        <path class="tick t2" d="M14.6 25.4l1.7 1.7 3-3.4" stroke-width="1.6" />
        <path class="tick t3" d="M14.6 32.4l1.7 1.7 3-3.4" stroke-width="1.6" />
        <path d="M22 18.8h7.5M22 25.8h7.5M22 32.8h4.5" stroke-width="1.4" opacity="0.7" />
      </g>
      <g class="rosette">
        <path d="M33.2 38.5l-1.8 6 3.2-1.7 2.4 2.7.6-6.2M39.8 38.5l1.8 6-3.2-1.7" fill="url(#b-gold-j)" opacity="0.85" />
        <circle cx="36.5" cy="34.5" r="6.2" fill="url(#b-gold-j)" />
        <circle cx="36.5" cy="34.5" r="4.4" fill="none" stroke="#fff8e6" stroke-width="0.8" opacity="0.7" />
        <path d="M36.5 31.4l.9 1.9 2 .2-1.5 1.4.4 2-1.8-1-1.8 1 .4-2-1.5-1.4 2-.2z" fill="#fff8e6" />
      </g>
    </svg>
  )}
</span>

<style>
  .badge {
    width: var(--s); height: var(--s); flex: none; display: grid; place-items: center; border-radius: calc(var(--s) * 0.24);
    background: radial-gradient(circle at 30% 25%, rgba(246, 220, 156, 0.28), rgba(168, 122, 50, 0.1) 70%);
    border: 1px solid rgba(214, 172, 92, 0.35); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 8px 22px -12px rgba(168, 122, 50, 0.6);
  }
  .badge svg { width: 86%; height: 86%; overflow: visible; }
</style>
