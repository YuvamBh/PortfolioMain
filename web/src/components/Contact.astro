---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-main">
      <p class="eyebrow"><span class="num">07</span> Contact</p>
      <h2 id="contact-title" class="contact-title" data-split>Let’s build something people love to use.</h2>
    </div>
    <div class="contact-side">
    <p class="contact-lede prose" data-reveal>I’m looking for product and full-stack engineering roles, and work in AI and machine learning.</p>
    <div class="contact-actions" data-reveal>
      <span class="split split-primary">
        <a class="split-main" href={`mailto:${profile.email}`}><Icon name="mail" /> Email me</a>
        <button type="button" class="split-copy" data-copy={profile.email} aria-label={`Copy ${profile.email}`} title="Copy email">
          <span class="i-copy"><Icon name="copy" size={16} /></span>
          <span class="i-done"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" /></svg></span>
        </button>
      </span>
      <a class="btn" href={profile.links.calendly} target="_blank" rel="noopener"><Icon name="calendar" /> Book a call</a>
    </div>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
    <ul class="contact-links" data-reveal>
      <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a></li>
      <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
      <li><a href={profile.resume} target="_blank" rel="noopener"><Icon name="download" /> Resume (PDF)</a></li>
    </ul>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px clamp(40px, 6vw, 96px); align-items: end; }
  .contact-title { font-size: clamp(40px, 6vw, 96px); line-height: 0.98; letter-spacing: -0.035em; margin-top: 22px; max-width: 12ch; }
  .contact-lede { color: var(--text-2); font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; max-width: 44ch; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 20px; }
  @media (max-width: 960px) { .contact-grid { grid-template-columns: 1fr; } }
  .contact-links { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .contact-links a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--text-2); text-decoration: none; font-weight: 500; }
  .contact-links a:hover { color: var(--text); }
  .split { display: inline-flex; align-items: stretch; min-height: 46px; border: 1px solid rgba(var(--ink), 0.28); background: rgba(var(--ink), 0.04); }
  .split-main {
    display: inline-flex; align-items: center; gap: 10px; padding: 0 20px; text-decoration: none; color: var(--text);
    font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; transition: background 0.25s ease, color 0.25s ease;
  }
  .split-main:hover { background: var(--text); color: var(--bg); }
  .split-copy {
    position: relative; width: 52px; flex: none; display: grid; place-items: center; cursor: pointer; color: var(--text);
    background: transparent; border: 0; border-left: 1px solid rgba(var(--ink), 0.22); transition: background 0.25s ease, color 0.25s ease;
  }
  .split-copy:hover { background: rgba(var(--ink), 0.1); }
  .split-copy > span { position: absolute; display: grid; transition: opacity 0.25s ease, transform 0.35s var(--ease-out); }
  .i-done { opacity: 0; transform: scale(0.6); color: var(--accent); }
  .split-copy.done .i-copy { opacity: 0; transform: scale(0.6); }
  .split-copy.done .i-done { opacity: 1; transform: none; }
  .split-primary { background: var(--text); border-color: var(--text); }
  .split-primary .split-main, .split-primary .split-copy { color: var(--bg); }
  .split-primary .split-main:hover { background: var(--accent); color: var(--accent-ink); }
  .split-primary .split-copy { border-left-color: color-mix(in srgb, var(--bg) 25%, transparent); }
  .split-primary .split-copy:hover { background: var(--accent); color: var(--accent-ink); }
  .split-primary .i-done { color: inherit; }
  @media (max-width: 640px) { .split { width: 100%; } .split-main { flex: 1; justify-content: center; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const status = document.querySelector('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('done');
        if (status) status.textContent = 'Email address copied';
        setTimeout(() => { btn.classList.remove('done'); if (status) status.textContent = ''; }, 1800);
      } catch {
        if (status) status.textContent = `Email: ${btn.dataset.copy ?? ''}`;
      }
    });
  });
</script>
