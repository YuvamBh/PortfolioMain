---
// Toolkit: four cards, each a short note and a grid of tool logos, most relevant first. Sits right after
// Selected work, so the tools follow the projects built with them.
import { profile } from '../data/profile';
const { skills } = profile;
---
<section id="toolkit" class="section toolkit" aria-labelledby="toolkit-title">
  <div class="wrap">
    <div class="toolkit-head">
      <div class="section-head">
        <p class="eyebrow"><span class="num">03</span> Toolkit</p>
        <h2 id="toolkit-title" class="section-title" data-split>What I build with.</h2>
      </div>
      <p class="prose" data-reveal>What I reach for, from the first model to the shipped product.</p>
    </div>
    <div class="tk-grid">
      {skills.map((g, i) => (
        <article class="tk glass" data-reveal>
          <header class="tk-head">
            <span class="tk-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="tk-name">{g.group}</h3>
          </header>
          <p class="tk-note">{g.note}</p>
          <ul class="tk-tools">
            {g.tools.map((t) => (
              <li class="tool">
                <span class="tool-icon" aria-hidden="true" style={`--icon:url(/tools/${t.icon}.svg)`}></span>
                <span class="tool-name">{t.name}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .toolkit-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .toolkit-head .section-head, .toolkit-head > .prose { margin-bottom: clamp(28px, 4vw, 48px); }
  .toolkit-head > .prose { max-width: 40ch; color: var(--text-2); }
  .tk-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .tk { display: flex; flex-direction: column; gap: 14px; padding: 26px; border-radius: var(--radius-lg); }
  .tk-head { display: flex; align-items: baseline; gap: 12px; }
  .tk-num { font-family: var(--font-mono); font-size: 11px; color: var(--accent); }
  .tk-name { font-size: clamp(22px, 2vw, 28px); }
  .tk-note { color: var(--text-2); font-size: 15px; line-height: 1.6; max-width: 46ch; }
  .tk-tools { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 10px; margin-top: 6px; }
  .tool {
    display: grid; justify-items: center; gap: 10px; padding: 16px 8px 12px; border-radius: 10px; text-align: center;
    background: rgba(var(--ink), 0.035); border: 1px solid var(--line);
    transition: border-color 0.3s ease, translate 0.4s var(--ease-out), background 0.3s ease;
  }
  .tool:hover { border-color: rgba(201, 169, 110, 0.5); background: rgba(201, 169, 110, 0.08); translate: 0 -2px; }
  .tool-icon {
    width: 28px; height: 28px; background: var(--text); transition: background 0.3s ease;
    -webkit-mask: var(--icon) center / contain no-repeat; mask: var(--icon) center / contain no-repeat;
  }
  .tool:hover .tool-icon { background: var(--accent); }
  .tool-name { font-size: 12px; line-height: 1.3; color: var(--text-2); }

  @media (max-width: 760px) {
    .tk-grid { grid-template-columns: 1fr; }
  }
</style>
