---
// Toolkit: one band of logos per group. The group's name sits in the middle and the band slides behind it,
// endlessly, one band to the left and the next to the right. Tools come in a shuffled order (fixed at build,
// so it's the same on every visit). The bands are on screen from the start (no scroll-in); with reduced
// motion the logos stand still and wrap under the name.
// Sits right after Selected work, so the tools follow the projects built with them.
import { profile } from '../data/profile';
const { skills } = profile;

// Seeded shuffle: mixed, but stable from build to build.
const shuffle = <T,>(list: T[], seed: number): T[] => {
  const a = [...list];
  let s = seed;
  const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
  for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
};
const bands = skills.map((g, i) => ({ ...g, tools: shuffle(g.tools, 17 + i * 31) }));
---
<section id="toolkit" class="section toolkit" aria-labelledby="toolkit-title">
  <div class="wrap">
    <div class="toolkit-head">
      <div class="section-head">
        <p class="eyebrow"><span class="num">03</span> Toolkit</p>
        <h2 id="toolkit-title" class="section-title" data-split>What I build with.</h2>
      </div>
    </div>

    <div class="tk-bands">
      {bands.map((g, i) => (
        <div class:list={['tk-band', { 'is-reverse': i % 2 === 1 }]} style={`--dur:${g.tools.length * 3.8}s`}>
          <h3 class="tk-label">{g.group}</h3>
          <div class="tk-marquee">
            {[0, 1].map((copy) => (
              <ul class="tk-track" aria-hidden={copy === 1 ? 'true' : undefined} aria-label={copy === 0 ? g.group : undefined}>
                {g.tools.map((t) => (
                  <li class="tool">
                    <span class="tool-icon" aria-hidden="true" style={`--icon:url(/tools/${t.icon}.svg)`}></span>
                    <span class="tool-name">{t.name}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .toolkit-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .toolkit-head .section-head { margin-bottom: clamp(28px, 4vw, 48px); }

  .tk-bands { display: grid; gap: clamp(24px, 2.8vw, 36px); }
  .tk-band { position: relative; display: grid; align-items: center; }

  /* The name, plain, in the middle of the band. Nothing is painted behind it: the band itself fades out
     around the middle (see .tk-marquee), so it works on any background, light or dark. */
  .tk-label {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 1;
    padding: 10px 20px; white-space: nowrap;
    font-family: var(--font-body); font-weight: 600; font-size: 15px; letter-spacing: 0; line-height: 1.3; color: var(--text);
  }

  /* The band: two copies of the list side by side, both sliding one copy's width, so the loop never seams.
     The mask fades it out at both ends and leaves a clear gap in the middle for the name. */
  .tk-marquee {
    --gap: clamp(40px, 4vw, 60px);
    --fade: linear-gradient(90deg, transparent 0%, #000 8%, #000 calc(50% - 270px), transparent calc(50% - 140px),
      transparent calc(50% + 140px), #000 calc(50% + 270px), #000 92%, transparent 100%);
    display: flex; overflow: hidden; padding: 10px 0;
    -webkit-mask-image: var(--fade); mask-image: var(--fade);
  }
  .tk-track {
    list-style: none; flex: none; display: flex; align-items: center; gap: var(--gap); padding-right: var(--gap);
    animation: tk-slide var(--dur) linear infinite;
  }
  .is-reverse .tk-track { animation-direction: reverse; }
  @keyframes tk-slide { from { transform: translateX(0); } to { transform: translateX(-100%); } }

  .tool { display: flex; align-items: center; gap: 12px; white-space: nowrap; }
  .tool-icon {
    width: 30px; height: 30px; flex: none; background: var(--text);
    -webkit-mask: var(--icon) center / contain no-repeat; mask: var(--icon) center / contain no-repeat;
  }
  .tool-name { font-size: 17px; color: var(--text-2); }

  /* Phones: the name sits above its band. */
  @media (max-width: 760px) {
    .tk-band { row-gap: 10px; }
    .tk-label { position: static; translate: none; justify-self: center; padding: 0; }
    .tk-marquee { --fade: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-band { row-gap: 14px; }
    .tk-label { position: static; translate: none; justify-self: center; padding: 0; }
    .tk-track[aria-hidden] { display: none; }
    .tk-marquee { -webkit-mask-image: none; mask-image: none; }
    .tk-track { animation: none; flex-wrap: wrap; justify-content: center; flex: 1; row-gap: 16px; padding-right: 0; }
  }
</style>
