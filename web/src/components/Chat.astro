---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---
<button class="chat-fab" type="button" data-chat-open aria-haspopup="dialog" aria-controls="chat">
  <Icon name="sparkle" /><span>Ask about me</span>
</button>

<div class="chat" id="chat" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden data-chat>
  <div class="chat-head">
    <div>
      <p id="chat-title" class="chat-title">Ask about Yuvam</p>
      <p class="chat-sub">An AI assistant that answers from this portfolio</p>
    </div>
    <button class="chat-close" type="button" data-chat-close aria-label="Close chat"><Icon name="close" /></button>
  </div>
  <div class="chat-log" data-chat-log aria-live="polite">
    <div class="msg bot">Hi! Ask me about Yuvam’s design work, projects, experience or skills.</div>
  </div>
  <div class="chat-suggest" data-chat-suggest>
    <button type="button">What has he designed?</button>
    <button type="button">Tell me about Mystré</button>
    <button type="button">Can I see his resume?</button>
  </div>
  <form class="chat-form" data-chat-form>
    <label class="sr-only" for="chat-input">Your question</label>
    <input id="chat-input" name="q" autocomplete="off" maxlength="500" placeholder="Ask anything about Yuvam" required />
    <button class="chat-send" type="submit" aria-label="Send"><Icon name="send" /></button>
  </form>
</div>

<style>
  .chat-fab {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 85;
    display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 18px;
    border: 1px solid rgba(var(--ink), 0.2);
    background: linear-gradient(180deg, rgba(var(--glass-top), 0.72) 0%, rgba(var(--glass-foot), 0.6) 100%);
    backdrop-filter: blur(22px) saturate(160%); -webkit-backdrop-filter: blur(22px) saturate(160%);
    font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 50px rgba(var(--shade), 0.35);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .chat-fab:hover { border-color: var(--accent); }
  .chat-fab[data-hide] { opacity: 0; transform: translateY(16px); pointer-events: none; }
  .chat {
    position: fixed; right: 16px; bottom: 16px; z-index: 110; width: min(400px, calc(100vw - 32px)); height: min(600px, calc(100svh - 32px));
    display: flex; flex-direction: column; border-radius: var(--radius-lg); border: 1px solid rgba(var(--ink), 0.16);
    background: linear-gradient(180deg, rgba(var(--glass-top), 0.86) 0%, rgba(var(--glass-foot), 0.8) 100%);
    backdrop-filter: blur(26px) saturate(160%); -webkit-backdrop-filter: blur(26px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), var(--shadow); overflow: hidden;
  }
  .chat[hidden] { display: none; }
  .chat-head { display: flex; justify-content: space-between; align-items: start; gap: 12px; padding: 18px 18px 14px; border-bottom: 1px solid var(--line); }
  .chat-title { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  .chat-sub { font-size: 13px; color: var(--text-3); }
  .chat-close { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid rgba(var(--ink), 0.2); background: rgba(var(--ink), 0.04); cursor: pointer; flex: none; }
  .chat-log { flex: 1; overflow-y: auto; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .msg { max-width: 88%; padding: 10px 14px; border-radius: 4px; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }
  .msg.bot { background: rgba(var(--ink), 0.05); border: 1px solid var(--line); align-self: flex-start; }
  .msg.user { background: var(--text); color: var(--bg); align-self: flex-end; }
  .msg :global(a) { color: inherit; }
  .msg :global(.msg-btn) { display: inline-flex; margin-top: 8px; min-height: 40px; align-items: center; padding: 0 14px; background: var(--accent); color: var(--accent-ink); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; }
  .msg.typing { color: var(--text-3); }
  .chat-suggest { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 12px; }
  .chat-suggest button { min-height: 36px; padding: 0 12px; border: 1px solid var(--line); background: rgba(var(--ink), 0.03); font-size: 13px; color: var(--text-2); cursor: pointer; }
  .chat-suggest button:hover { border-color: var(--line-strong); color: var(--text); }
  .chat-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); padding-bottom: max(12px, env(safe-area-inset-bottom)); }
  .chat-form input {
    flex: 1; min-width: 0; min-height: 46px; padding: 0 14px; border: 1px solid rgba(var(--ink), 0.2);
    background: rgba(var(--paper), 0.6); color: var(--text); font: inherit; font-size: 16px;
  }
  .chat-form input::placeholder { color: var(--text-3); }
  .chat-send { width: 46px; height: 46px; border: 0; background: var(--text); color: var(--bg); display: grid; place-items: center; cursor: pointer; flex: none; }
  @media (max-width: 560px) {
    .chat { inset: 0; width: 100%; height: 100svh; border-radius: 0; border: 0; }
    .chat-fab span { display: none; }
    .chat-fab { padding: 0; width: 52px; justify-content: center; }
  }
</style>

<script define:vars={{ resume: profile.resume, email: profile.email }}>
  const chat = document.querySelector('[data-chat]');
  const log = chat.querySelector('[data-chat-log]');
  const form = chat.querySelector('[data-chat-form]');
  const input = chat.querySelector('#chat-input');
  const suggest = chat.querySelector('[data-chat-suggest]');
  const fab = document.querySelector('.chat-fab');
  const history = [];
  let opener = null;
  let busy = false;

  const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const render = (text) => {
    let h = esc(text).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
    h = h.replace(/\[\[RESUME\]\]/g, `<br><a class="msg-btn" href="${resume}" target="_blank" rel="noopener">Open resume (PDF)</a>`);
    return h;
  };
  const add = (role, text) => {
    const el = document.createElement('div');
    el.className = `msg ${role}`;
    el.innerHTML = role === 'bot' ? render(text) : esc(text);
    log.appendChild(el); log.scrollTop = log.scrollHeight;
    return el;
  };

  const open = (from) => {
    opener = from || document.activeElement;
    chat.hidden = false; fab?.setAttribute('data-hide', '');
    document.querySelectorAll('[data-chat-open]').forEach((b) => b.setAttribute('aria-expanded', 'true'));
    if (matchMedia('(max-width: 560px)').matches) { document.body.style.overflow = 'hidden'; window.__lenis?.stop(); }
    setTimeout(() => input.focus(), 30);
  };
  const close = () => {
    chat.hidden = true; fab?.removeAttribute('data-hide');
    document.querySelectorAll('[data-chat-open]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    document.body.style.overflow = ''; window.__lenis?.start();
    opener?.focus?.();
  };
  document.querySelectorAll('[data-chat-open]').forEach((b) => b.addEventListener('click', () => open(b)));
  chat.querySelector('[data-chat-close]').addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !chat.hidden) close(); });

  const ask = async (q) => {
    if (busy || !q.trim()) return;
    busy = true; suggest.hidden = true;
    add('user', q); history.push({ role: 'user', content: q });
    const typing = add('bot', 'Thinking…'); typing.classList.add('typing');
    try {
      const res = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history.slice(-10) }) });
      const data = await res.json().catch(() => ({}));
      typing.remove();
      if (!res.ok || !data.reply) throw new Error(data.error || 'failed');
      add('bot', data.reply); history.push({ role: 'assistant', content: data.reply });
    } catch (err) {
      typing.remove();
      add('bot', `Sorry, I can’t answer right now. You can email Yuvam at ${email}.`);
    } finally { busy = false; }
  };
  const footer = document.querySelector('.footer');
  if (footer && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => { if (chat.hidden) fab?.toggleAttribute('data-hide', e.isIntersecting); }, { threshold: 0.15 }).observe(footer);
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); const q = input.value; input.value = ''; ask(q); });
  suggest.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')));
</script>
