---
// About: who I am through the work (Mystré first, then the internship and campus roles),
// focus and a one-line education note. The toolkit has its own section (Toolkit.astro).
// The diploma version of education lives in Diploma.astro if it's ever wanted back.
import { profile } from '../data/profile';
const { bio, focus, now, education } = profile;
---
<section id="about" class="section about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow"><span class="num">01</span> About</p>
      <h2 id="about-title" class="section-title" data-split>Products, from idea to launch.</h2>
    </div>

    <div class="about-grid">
      <figure class="about-photo" data-clip>
        <img src="/img/yuvam.webp" width="506" height="900" alt="Portrait of Yuvam Bhargav" loading="lazy" decoding="async" data-parallax="5" />
      </figure>

      <div class="about-body">
        <div>
          {bio.map((para, i) => (
            <p class:list={['prose', { lead: i === 0 }]} data-reveal>
              {para.map((seg) => typeof seg === 'string' ? seg : (
                <a class="lp" href={seg.href} target="_blank" rel="noopener" data-lp={seg.preview}>{seg.text}</a>
              ))}
            </p>
          ))}
        </div>

        <div class="about-cols">
          <div data-reveal>
            <h3 class="mini">Focus</h3>
            <ul class="list">{focus.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div data-reveal>
            <h3 class="mini">Right now</h3>
            <ul class="list">{now.map((f) => <li>{f}</li>)}</ul>
          </div>
        </div>

        <div class="edu" data-reveal>
          <img class="edu-seal" src={education.seal} alt="" width="52" height="52" loading="lazy" decoding="async" />
          <div>
            <p class="edu-school">{education.school}</p>
            <p class="edu-line">B.S. Computer Science (AI) · B.S. Data Science · {education.dates}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="lp-card" aria-hidden="true" data-lp-card><img alt="" data-lp-img /></div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .about-photo { margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; background: var(--surface); position: sticky; top: calc(var(--nav-h) + 32px); border: 1px solid var(--line); }
  .about-photo img { width: 100%; height: 112%; object-fit: cover; object-position: center 20%; }
  .about-body { display: grid; gap: 36px; }
  .lead { color: var(--text); font-size: clamp(19px, 1.6vw, 22px); line-height: 1.6; }
  .about-body .prose { color: var(--text-3); }
  .about-body .lead { color: var(--text-2); }

  /* Linked words in the bio, with a floating preview of the page (like Aceternity's link preview). */
  .lp { color: var(--text); font-weight: 600; text-decoration: none; background-image: linear-gradient(var(--accent), var(--accent)); background-size: 0% 1px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 0.35s var(--ease-out); }
  .lp:hover, .lp:focus-visible { background-size: 100% 1px; }
  .lp-card {
    position: fixed; left: 0; top: 0; z-index: 95; width: 260px; pointer-events: none; visibility: hidden;
    padding: 5px; border-radius: 14px; background: #fff; box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.55);
  }
  .lp-card img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; }
  @media (hover: none) { .lp-card { display: none; } }


  .about-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .mini { font-family: var(--font-body); font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-3); margin-bottom: 16px; }
  .list { list-style: none; display: grid; gap: 12px; }
  .list li { position: relative; padding-left: 18px; color: var(--text-2); font-size: 16px; line-height: 1.6; }
  .list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; background: var(--accent); }

  /* Education: one quiet line beside the seal, no box. */
  .edu { display: flex; align-items: center; gap: 16px; padding-top: 4px; }
  .edu-seal { width: 52px; height: 52px; flex: none; opacity: 0.9; }
  :global([data-theme='dark']) .edu-seal { filter: brightness(1.6) saturate(0.9); }
  .edu-school { font-weight: 600; font-size: 16px; color: var(--text); }
  .edu-line { font-size: 14px; color: var(--text-3); margin-top: 2px; }

  @media (max-width: 960px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { position: relative; top: 0; max-width: 420px; }
  }
  @media (max-width: 640px) {
    .about-cols { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Link preview: while the pointer is over a linked word, a preview of the page springs up above it and
  // follows the pointer sideways; clicking opens the page. It hides the moment the pointer leaves or the
  // page scrolls, and ignores hovers caused only by the page scrolling under a still pointer.
  import gsap from 'gsap';
  const card = document.querySelector<HTMLElement>('[data-lp-card]');
  const img = document.querySelector<HTMLImageElement>('[data-lp-img]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lp'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (card && img && links.length && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.body.appendChild(card);
    links.forEach((a) => { const pre = new Image(); pre.src = a.dataset.lp ?? ''; });
    const W = 260, H = 172;
    let current: HTMLAnchorElement | null = null;
    let scrollingUntil = 0;
    const clampX = (x: number) => Math.min(window.innerWidth - W - 12, Math.max(12, x - W / 2));
    const placeY = (a: HTMLElement) => { const r = a.getBoundingClientRect(); return r.top - H - 14 > 0 ? r.top - H - 14 : r.bottom + 14; };
    const hide = () => {
      if (!current) return;
      current = null;
      gsap.killTweensOf(card);
      gsap.to(card, { autoAlpha: 0, scale: reduce ? 1 : 0.9, duration: 0.18, ease: 'power2.in' });
    };
    const show = (a: HTMLAnchorElement, px: number) => {
      if (performance.now() < scrollingUntil) return;
      current = a;
      img.src = a.dataset.lp ?? '';
      gsap.killTweensOf(card);
      gsap.set(card, { x: clampX(px), y: placeY(a) });
      gsap.fromTo(card, { autoAlpha: 0, scale: reduce ? 1 : 0.6, rotate: reduce ? 0 : -6, transformOrigin: '50% 100%' },
        { autoAlpha: 1, scale: 1, rotate: 0, duration: reduce ? 0.15 : 0.5, ease: reduce ? 'none' : 'back.out(1.8)' });
    };
    links.forEach((a) => {
      a.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') show(a, e.clientX); });
      a.addEventListener('pointerleave', hide);
      a.addEventListener('pointermove', (e) => {
        if (current !== a) { if (e.pointerType === 'mouse') show(a, e.clientX); return; }
        gsap.to(card, { x: clampX(e.clientX), y: placeY(a), duration: 0.35, ease: 'power3.out', overwrite: 'auto' });
      });
    });
    // Safety: any pointer movement that isn't over the active link hides the preview.
    document.addEventListener('pointermove', (e) => { if (current && !current.contains(e.target as Node)) hide(); }, { passive: true });
    const onScroll = () => { scrollingUntil = performance.now() + 250; hide(); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('wheel', onScroll, { passive: true });
    window.addEventListener('blur', hide);
  }
</script>
